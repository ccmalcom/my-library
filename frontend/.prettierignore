# Generated by Next.js and marked "should not be edited". Its import path flips
# between .next/types/ and .next/dev/types/ depending on whether `next build` or
# `next dev` ran last, so formatting it just creates churn.
next-env.d.ts

# Recorded parity fixtures, written by scripts/gen_claude_fixtures.py with
# json.dumps(indent=1). Prettier wants 2-space, so formatting them is undone by
# the very next re-record -- and these files are only ever read via JSON.parse,
# so their layout is never load-bearing. Ignore rather than fight the generator.
lib/server/__tests__/fixtures/claude/

# Same deal for the FastAPI parity fixtures, written by
# scripts/gen_parity_fixtures.py with json.dumps(indent=1). This directory was
# missed when the rule above was added: seed.json, python-responses.json and
# write-scenarios.json have never been Prettier-clean on any commit, so the
# stop-time `prettier --check` fired the moment a re-record touched them.
lib/server/__tests__/fixtures/parity/

# And the catalog fixtures, written by scripts/gen_catalog_fixtures.py with the
# same json.dumps(indent=1). Missed for the same reason as parity/ above:
# expected.json and http.json have never been Prettier-clean on any commit, so
# nothing complained until wave 4c-1's re-record made them dirty.
lib/server/__tests__/fixtures/catalog/

# drizzle-kit's own bookkeeping, rewritten by `npm run db:generate` on every
# run. Same deal as the fixtures above: Prettier's layout is undone by the very
# next generate, and drizzle only ever reads these via JSON.parse, so their
# formatting is never load-bearing. The .sql migrations alongside them are not
# ignored -- Prettier has no SQL parser, so it skips them on its own, and the
# hand-corrected `ALTER COLUMN ... USING` statements must stay reviewable.
drizzle/meta/
